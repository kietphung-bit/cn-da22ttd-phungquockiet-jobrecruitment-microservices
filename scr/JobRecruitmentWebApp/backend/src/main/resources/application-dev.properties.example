# ============================================
# CẤU HÌNH DEV (Chạy JDK cục bộ)
# ============================================
# Mục tiêu: Chạy trên localhost với JDK trực tiếp
# Cơ sở dữ liệu: PostgreSQL chạy trên localhost
# Bảo mật: Thông tin đăng nhập yếu để thuận tiện (CHỈ DÙNG CHO PHÁT TRIỂN!)
# ============================================
# KẾT NỐI CƠ SỞ DỮ LIỆU
# ============================================
spring.datasource.url=jdbc:postgresql://localhost:5432/jobrecruitment_dev
spring.datasource.username=postgres
spring.datasource.password=

# ============================================
# CẤU HÌNH JPA/HIBERNATE (DEV)
# ============================================
# Dialect được tự động phát hiện bởi Hibernate 6+ (không cần chỉ định rõ ràng)
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# ============================================
# CẤU HÌNH JWT (CHỈ DÙNG CHO DEV - SECRET YẾU)
# ============================================
# CẢNH BÁO: Đây là secret yếu chỉ để thuận tiện cho phát triển!
# KHÔNG BAO GIỜ sử dụng trong production!
app.jwt.secret=DevSecretKeyForLocalTesting123456789DoNotUseInProduction
app.jwt.expiration=86400000

# ============================================
# CẤU HÌNH LOGGING
# ============================================
logging.level.org.springframework.web=DEBUG
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE
logging.level.com.jobrecruitment.backend=DEBUG

# ============================================
# SWAGGER/OPENAPI (Có thể truy cập trong Docker)
# ============================================
# Cho phép truy cập từ bất kỳ host nào (cho mạng Docker nội bộ)
springdoc.swagger-ui.disable-swagger-default-url=true
springdoc.swagger-ui.use-root-path=false

# ============================================
# DATA SEEDING
# ============================================
# DataSeeder sẽ tự động chạy khi khởi động
app.seed-data-on-startup=true

# ============================================
# TẢI LÊN TỆP
# ============================================
# File upload configuration
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Custom file storage configuration
app.upload.dir=uploads
app.upload.max-size=10485760

# ============================================
# CẤU HÌNH JACKSON JSON
# ============================================
# Định dạng ngày/giờ
spring.jackson.date-format=yyyy-MM-dd'T'HH:mm:ss
spring.jackson.time-zone=Asia/Ho_Chi_Minh
# Xử lý giá trị null
spring.jackson.default-property-inclusion=NON_NULL

# ============================================
# TỐI ƯU HIỆU SUẤT JPA
# ============================================
# Vô hiệu hóa open-in-view để ngăn chặn các vấn đề lazy loading
spring.jpa.open-in-view=false

# ============================================
# CẤU HÌNH SERVER XỬ LÝ YÊU CẦU
# ============================================
server.port=5000
# Lưu ý: Chi tiết lỗi được kiểm soát bởi các trình xử lý ngoại lệ trong GlobalExceptionHandler

# ============================================
# SWAGGER/OPENAPI UI
# ============================================
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.operationsSorter=method
springdoc.swagger-ui.tagsSorter=alpha

# ============================================
# RATE LIMITING (Bucket4j)
# ============================================
# Public endpoints (Low Trust): Limit by IP Address
rate.limit.public.capacity=50
rate.limit.public.refill.tokens=50
rate.limit.public.refill.minutes=1
# Authenticated endpoints (High Trust): Limit by User ID
rate.limit.authenticated.capacity=100
rate.limit.authenticated.refill.tokens=100
rate.limit.authenticated.refill.minutes=1